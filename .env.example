# Plantilla de configuración de YacaloX AI.
# Copia este archivo a `.env` y rellena los valores.
# NUNCA subas el archivo `.env` real al repositorio.

# --- Proveedor de lenguaje (Ollama local) ---
YACALOX_PROVIDER=ollama
YACALOX_OLLAMA_URL=http://127.0.0.1:11434
YACALOX_MODEL=qwen3:1.7b
YACALOX_TIMEOUT=300
YACALOX_THINK=false

# --- Comportamiento del asistente ---
YACALOX_MAX_TOOL_ITERATIONS=6
YACALOX_HISTORY_WINDOW=12
YACALOX_TEMPERATURE=0.4
YACALOX_LOG_LEVEL=INFO
YACALOX_NUM_CTX=8192

# --- Datos ---
YACALOX_DATA_DIR=data

# --- YouTube Data API v3 ---
YOUTUBE_API_KEY=
YACALOX_YOUTUBE_DAILY_QUOTA=10000
YACALOX_YOUTUBE_CACHE_TTL=21600
YACALOX_YOUTUBE_REGION=CO
YACALOX_YOUTUBE_LANGUAGE=es
YACALOX_YOUTUBE_TIMEOUT=20AIzaSyBXV6tzSAyIiyBf6W5_Z951BtmfSxikl8k

# --- Fase 3+: OAuth de YouTube Analytics (archivo local, excluido de git) ---
# Ruta relativa al proyecto del archivo de cliente descargado de Google Cloud.
YOUTUBE_CLIENT_SECRETS=data/client_secret.json
